{
  "name": "issues-gateway",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "issues-gateway",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "pip install --user -r requirements-dev.txt && cp -n .env.example .env || true",

  "postAttachCommand": {
    "hint": "echo 'Set GITHUB_TOKEN / GITHUB_OWNER / GITHUB_REPO / WEBHOOK_SECRET in .env, then: make run'"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "42Crunch.vscode-openapi",
        "humao.rest-client"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests", "-m", "not integration and not tunnel"],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "yaml.schemas": {
          "https://raw.githubusercontent.com/OAI/OpenAPI-Specification/main/schemas/v3.1/schema.json": "openapi.yaml"
        }
      }
    }
  },

  "remoteUser": "vscode"
}
