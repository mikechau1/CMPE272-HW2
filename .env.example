# Copy to .env and fill in.  .env is git-ignored -- never commit real values.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Fine-grained PAT scoped to GITHUB_OWNER/GITHUB_REPO with:
#   Repository permissions -> Issues: Read and write
#   Repository permissions -> Metadata: Read-only  (granted automatically)
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Owner (user or org) of the test repository.
GITHUB_OWNER=mikechau1

# Name of the test repository.
GITHUB_REPO=cmpe272-issues-gw

# Shared secret used to sign/verify webhook deliveries (HMAC-SHA256).
# Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=change-me-openssl-rand-hex-32

# Port this service listens on.
PORT=8000

# ---------------------------------------------------------------------------
# Optional (sensible defaults shown)
# ---------------------------------------------------------------------------

# GITHUB_API_URL=https://api.github.com
# LOG_LEVEL=INFO
# LOG_FORMAT=json                 # json | text
# EVENT_STORE_PATH=data/events.db # ":memory:" for an ephemeral store
# EVENT_RETENTION=500             # rows kept in the webhook event store
# GITHUB_TIMEOUT_S=10.0
# GITHUB_MAX_RETRIES=3
# ENABLE_ETAG_CACHE=true          # conditional GET / If-None-Match (extra credit)
# MAX_WEBHOOK_BODY_BYTES=5242880  # 5 MiB
